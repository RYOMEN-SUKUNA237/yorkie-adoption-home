# Supabase credentials for THIS project.
#
# Yorkshire Adoption Home has its own Supabase project, its own repository and
# its own deployment. Do not reuse credentials from any other site.
#
# Copy to `.env.local` and fill in. The site runs without them, falling back to
# the bundled sample content, but nothing is persisted until they are set.

# ---------------------------------------------------------------------
# Browser (safe to ship - RLS is what protects the data behind this key)
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_SITE_NAME=Yorkshire Adoption Home

# ---------------------------------------------------------------------
# Migrations only (local tooling - never bundled, because no VITE_ prefix)
# ---------------------------------------------------------------------
# Session-mode pooler, port 5432. Required by `npm run db:migrate`.
# Percent-encode special characters in the password ($ -> %24).
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Transaction-mode pooler, port 6543. For a serverless runtime; cannot run DDL.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# ---------------------------------------------------------------------
# Email - Resend (serverless functions only, never bundled)
# ---------------------------------------------------------------------
# Resend is the verified sender for yorkieadoptionhome.com: DKIM at
# resend._domainkey, Return-Path under the `send.` subdomain. It is the only
# outbound path. Sending the same From: address through Gmail SMTP fails
# DMARC alignment and lands in spam, which is why that fallback was removed.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=support@yorkieadoptionhome.com

# Signing secret for the Resend webhook, from Resend -> Webhooks -> your
# endpoint. Without it /api/inbound-email accepts unsigned requests, so
# anyone who knows the URL can file mail into the dashboard and make the site
# send. Set this.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Where operational alerts go. Comma separated. Never a client-facing
# address, and never FROM_EMAIL itself, which would loop.
ADMIN_NOTIFY_EMAILS=you@example.com,colleague@example.com

# Absolute origin used in email links. VERCEL_URL is a per-deploy hostname
# and must never reach a client, so this wins when set.
PUBLIC_SITE_URL=https://www.yorkieadoptionhome.com

# ---------------------------------------------------------------------
# WhatsApp - automatic delivery (pick ONE provider)
# ---------------------------------------------------------------------
# Set nothing and no message is delivered: /api/send-whatsapp returns 503 and
# the dashboard says so rather than pretending it sent.
#
# Before either provider will work at all, know the platform rule: WhatsApp
# refuses free-form business messages more than 24 hours after the client last
# wrote to you (Meta error 131047). Outside that window only a pre-approved
# template is accepted. Get one approved, name it below, and delivery works at
# any time.

# Option A - Meta WhatsApp Cloud API. Free tier, no middleman.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

# Option B - Twilio. Easier signup, per-message cost. Do not point this at
# Twilio's shared sandbox number in production; recipients must join it by
# texting a code first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Applicants often type a national number with no country code. This decides
# what a bare ten-digit number means.
DEFAULT_COUNTRY_CODE=1

# ---------------------------------------------------------------------
# Optional - lets the functions bypass RLS when writing logs
# ---------------------------------------------------------------------
# Migration 0011 makes public.emails and public.whatsapp_logs write-only for
# the publishable key and staff-only to read. Setting this closes even the
# insert. Server-side only; it bypasses every RLS policy, so it must never
# carry a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Never put a service/secret key in this file. It bypasses every RLS policy,
# and anything reachable by the build can end up in the browser bundle.
